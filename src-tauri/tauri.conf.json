{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drift",
  "version": "0.1.0",
  "identifier": "app.drift.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Drift — Games live on.",
        "width": 1280,
        "height": 800,
        "minWidth": 920,
        "minHeight": 620,
        "backgroundColor": "#0d141b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
